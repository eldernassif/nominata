{
  "name": "nominata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run verify:types && npm run verify:lint && npm run verify:db && npm run verify:unit && npm run verify:componente && npm run verify:contrato && npm run verify:e2e",
    "verify:rapido": "npm run verify:types && npm run verify:unit",
    "verify:types": "tsc --noEmit",
    "verify:lint": "eslint . --max-warnings=0",
    "verify:db": "supabase db lint --level error --fail-on error && supabase test db",
    "verify:unit": "vitest run --project unit",
    "verify:componente": "vitest run --project componente",
    "verify:contrato": "vitest run --project contrato",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "verify:rls-mutacao": "tsx scripts/rls-mutacao.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supabase": "2.114.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  }
}
